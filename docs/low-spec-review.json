  "decision": "accepted",
  "target": {
    "cpu_cores": 2,
    "ram_gib": 4,
    "disk": "HDD"
  },
  "impact": {
    "memory": "One threading.Event per active job, replaced on next start; no PDF/page cache or extra worker. Existing one-page image memory, one shared preview process and bounded32 image events remain. Two fresh240-page source runs: home idle64.85MiB before vs64.21MiB after; similar range, not a reduction claim.",
    "cpu_ui": "Cancel sets an Event on Tk and workers check safe boundaries without polling sleeps or native termination. Busy/loader remain until cleanup; native stop/retry tests passed at100%/125%. Existing shell poll reused.",
    "disk_startup": "No startup scan or additional dependency; PDF staging rollback uses existing output identities. Image stop retains complete images and a closed streaming CSV. EXE cold HDD startup still unmeasured.",
    "dependencies": "Uses standard threading.Event and existing headless DocumentError/engines; no new dependency or spawned process. Default export concurrency remains one.",
    "output_quality": "Cancellation never reduces DPI, pixels or encoder quality. Four codecs verify retained page dimensions, decoded lossless pixels and matching CSV bytes. PDF rollback preserves originals, existing files and externally changed outputs; retry uses exclusive publication."
  },
  "limitations": [
    "Development Windows10 host; not physical2-core/4-GiB/HDD or Windows11 certification",
    "Native insert/render/encode/save calls complete before cancellation; longest safe step determines stop latency",
    "Warm240-page resource benchmark is not scanned-PDF/frozen peak or cold-HDD startup certification"
  ],
