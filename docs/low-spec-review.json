  "target": {
    "cpu_cores": 2,
    "ram_gib": 4,
    "disk": "HDD"
  },
  "impact": {
    "memory": "Shared coordinator1/request16/result4/comparison12/6MiB/events32 unchanged. Image metadata only in settings; worker decode limited20MiB/16MP. Export overlay LRU text8/image2 closes in context on errors/cancel; single-page preview save/read never serializes full document.1000text affinity2 peak49.79MiB versus393.66 before overlay reuse; not large scan/image maximum proof.",
    "cpu_ui": "One import/export worker, shared busy lock; Tk handles controls and immutable metadata only. Story shaping and image decode happen off Tk. Same-text overlays reuse font/image graft objects;1000text export112.62 to13.11seconds on identical synthetic workload. Native920x700100/125 and Tab-reveal tested; cancellation waits current native decode/save call.",
    "disk_startup": "No new runtime dependency; lazy registry imports watermark only on use. Images are validated once in import worker, stat signatures checked again. Preview saves/read only requested page in memory; export stages beside target, reopens geometry and publishes exclusively. Original bytes unchanged; no HDD or cold-start certification.",
    "dependencies": "Uses installed PyMuPDF Story, Pillow and bundled Noto Sans Thai OFL already shipped. No new process, polling timer or heavy library. Serif uses MuPDF bundled fonts plus Thai fallback. All original feature services remain headless.",
    "output_quality": "Native vector text and original PDF objects preserved; image alpha/opacity preserved without downsampling or lossy conversion. Shared stamp placement matches preview and export with requested-page serialization fixing PNG rounding. Rotation/CropBox/mixed size, links/bookmarks/annotations/editable forms and independent Poppler verified. No automatic size reduction; oversize watermark rejected. Overlay is not redaction or copy protection; signatures/scripts not guaranteed."
  },
  "limitations": [
    "Windows10 development host16 logical CPUs; affinity2 does not certify physical2core/4GiB/HDD orWindows11",
    "Synthetic1000text result is single before/after run, not statistical guarantee or large scan/maximum16MP peak",
    "Native decode/save calls finish before cancellation; exact preview saves one requested page and can cost more on complex pages",
    "No another physical machine test; EXE/Installer unsigned and repository private; PDF signatures/scripts not guaranteed",
    "Thai shaped watermark text extraction can decompose vowels/omit tone mappings despite correct visual rendering; original PDF text remains preserved"
  ],
