{
  "schema_version": 1,
  "version": "1.6.0",
  "decision": "accepted",
  "target": {
    "cpu_cores": 2,
    "ram_gib": 4,
    "disk": "HDD"
  },
  "impact": {
    "memory": "Larger selector 180x200-fit and comparison 320x400-fit previews retain viewport 24, cache 32/6 MiB and 12/6 MiB estimates, shared process request16/result4. Home idle median 65.04 MiB over five fresh source runs; no all-page images or extra worker. Hidden pages release images and timers.",
    "cpu_ui": "Shared workbench is geometry and controls only. Existing coalesced gesture/edge scrolling and merge drag retained. Larger preview pixels add bounded rendering work; no animation/new polling. Native 1000-page/1000-pointer and merge drag tests check responsiveness on development host.",
    "disk_startup": "No new backend, startup scan or preloading. Viewport coordinator renders only requested pages. PDF preflight still synchronous and HDD/cold frozen startup remains unmeasured.",
    "dependencies": "No new runtime dependency. Existing Tk/CustomTkinter/Pillow and spawned PyMuPDF. Service engines unchanged and workers never access Tk.",
    "output_quality": "Export services and DPI unchanged. Native suites check page contents, original hashes, collision refusal and real exports for all six tools. Enlarged navigation previews do not set output quality."
  },
  "limitations": [
    "Windows 10 development PC i7-11800H/about 40 GiB RAM; physical 2-core/4-GiB/HDD and Windows 11 not tested",
    "Selector 180x200-fit and comparison 320x400-fit previews are not full-resolution zoom",
    "Cache accounting estimates PIL/Tk image copies; scanned PDFs, frozen cold-start and export peak remain unmeasured",
    "Final spacing/focus adjustment after benchmark adds no widget, render pixels, process or cache"
  ],
